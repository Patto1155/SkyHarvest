<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compile-checks Assets/Editor/*.cs against UnityEngine + UnityEditor stubs. These editor
       scripts (verify harness, screenshots, build script) are not part of GameCode, so without
       this project a syntax/API error in them only surfaces when a human opens Unity. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SkyHarvest.EditorCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8632;CS0067;CS0108;CS0109;CS0114;CS0169;CS0414;CS0649;CS1998;CS0162;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../EditorStubs/*.cs" />
    <Compile Include="../../../Assets/Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCode/GameCode.csproj" />
    <ProjectReference Include="../UnityStubs/UnityStubs.csproj" />
  </ItemGroup>

</Project>
